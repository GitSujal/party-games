{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "party-games",
    "main": "src/worker/index.ts",
    "compatibility_date": "2026-10-01",

    // Static SPA build from Vite. /api/* always goes to the Worker first.
    "assets": {
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/api/*"]
    },

    // One Durable Object instance per room code.
    "durable_objects": {
        "bindings": [{ "name": "ROOMS", "class_name": "GameRoom" }]
    },
    "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GameRoom"] }],

    // Player photos and AI portraits (optional: games degrade gracefully without it).
    "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "party-games-media" }],

    // Per-IP rate limits. period must be 10 or 60 seconds.
    "ratelimits": [
        { "name": "CREATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
        { "name": "JOIN_LIMITER", "namespace_id": "1002", "simple": { "limit": 30, "period": 60 } }
    ],

    // Platform settings. Secrets (GEMINI_API_KEY) go in .dev.vars locally and `wrangler secret put` in prod.
    "vars": {
        "ROOM_TTL_HOURS": "24",
        "MAX_PLAYERS_PER_ROOM": "30",
        "ONE_PLAYER_PER_DEVICE": "false",
        "GEMINI_MODEL": "gemini-3-pro-image-preview",
        "GEMINI_FALLBACK_MODEL": "gemini-2.5-flash-image"
    },

    "routes": [{ "pattern": "partygames.datasparta.com", "custom_domain": true }],
    "observability": { "enabled": true }
}
