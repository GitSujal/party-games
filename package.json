{
    "name": "party-games",
    "version": "2.0.0",
    "private": true,
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "preview": "vite build && vite preview",
        "deploy": "node scripts/deploy.mjs",
        "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.worker.json --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "cf-typegen": "wrangler types src/worker/worker-configuration.d.ts --strict-vars=false",
        "new-game": "node scripts/new-game.mjs",
        "smoke": "node scripts/smoke.mjs"
    },
    "dependencies": {
        "canvas-confetti": "^1.9.4",
        "hono": "^4.13.14",
        "lucide-react": "^1.64.0",
        "qrcode": "^1.5.4",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-markdown": "^10.1.0",
        "react-router": "^8.5.1",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@cloudflare/vite-plugin": "^1.66.0",
        "@types/canvas-confetti": "^1.9.0",
        "@types/qrcode": "^1.5.6",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.2",
        "typescript": "^7.0.2",
        "vite": "^8.3.5",
        "vitest": "^4.1.12",
        "wrangler": "^4.156.0"
    },
    "type": "module"
}
